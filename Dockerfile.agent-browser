# adason overlay: official zeroclaw image + agent-browser CLI.
#
# The agent_browser backend drives the external browserless container via
# remote CDP (AGENT_BROWSER_CDP env, set in compose). No rust rebuild needed —
# agent-browser is a prebuilt static Rust binary from vercel-labs releases.
#
# Build context: the sibling `agent-browser` binary file (see the agent-browser-overlay workflow).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# --chmod: the runtime image builds as non-root, so a follow-up RUN chmod is
# not permitted; buildkit applies the mode at copy time instead.
COPY --chmod=755 agent-browser /usr/local/bin/agent-browser
